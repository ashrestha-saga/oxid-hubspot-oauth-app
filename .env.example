# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Public HTTPS base URL of this backend. Must match exactly what HubSpot calls,
# because the webhook v3 signature is computed over the full request URI.
# In local development use a tunnel (cloudflared / ngrok) and paste its URL here.
BASE_URL=https://your-backend.example.com

# ---------------------------------------------------------------------------
# Database (MySQL)
# Put the real password only in .env — never commit it.
# SSH tunnel from your Mac: ssh -L 3307:127.0.0.1:3306 USER@server-mwv01.virtualhosts.de
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://moxismbq:YOUR_PASSWORD@127.0.0.1:3307/usrdb_moxismbq_oxidhubspot"

# ---------------------------------------------------------------------------
# HubSpot app credentials (HubSpot developer account -> your app -> Auth)
# ---------------------------------------------------------------------------
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Optional — defaults to ${BASE_URL}/oauth/callback (recommended: omit and let it derive)
# HUBSPOT_REDIRECT_URI=https://your-backend.example.com/oauth/callback
HUBSPOT_SCOPES=crm.objects.contacts.read,crm.objects.contacts.write,oauth

# Numeric app id, shown in the developer portal URL. Needed to register the
# contact.propertyChange webhook subscription via the webhooks v3 API.
HUBSPOT_APP_ID=
# Developer API key of the developer account that owns the app (NOT a portal
# access token). Only used by `npm run hubspot:webhooks`.
HUBSPOT_DEVELOPER_API_KEY=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Signs the short-lived pairing session cookie issued after OAuth install.
# Generate the same way as above.
SESSION_SIGNING_KEY=

# ---------------------------------------------------------------------------
# OXID OAuth
# ---------------------------------------------------------------------------
# Optional; defaults to ${BASE_URL}/oxid/oauth/callback
# OXID_OAUTH_REDIRECT_URI=https://your-backend.example.com/oxid/oauth/callback
# OXID_OAUTH_SCOPES=profile,address,api

# stub  = in-memory fake, logs every call (use until the real OXID API is wired)
# oxapi = real OXID User API (updateUsers / insertUsers via OAuth bearer token)
OXID_CLIENT_MODE=stub
# Optional — only sent on insertUsers when set (AES-256-CBC encrypted; see API_DOCUMENTATION.md).
# OXID_USER_INSERT_PASSWORD=

# ---------------------------------------------------------------------------
# Sync engine
# ---------------------------------------------------------------------------
RECONCILE_INTERVAL_MINUTES=15
# Set to false on web instances if you run the queue worker as a separate process.
RUN_WORKER_IN_WEB=true
SYNC_WORKER_POLL_MS=2000
SYNC_JOB_MAX_ATTEMPTS=3
